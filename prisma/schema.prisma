// ShiftPatch data model. Seed data: docs/spec.md. Rules: docs/plan.md.

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  nurse
  agency
  admin
}

enum ShiftStatus {
  open
  filled
}

enum CredentialStatus {
  pending
  approved
  rejected
}

model Agency {
  id     String  @id
  name   String
  users  User[]
  shifts Shift[]
}

// One login per row. Agency logins use the agencyId as their id
// (plan.md: agency login returns user.id = agencyId).
model User {
  id           String  @id
  email        String  @unique
  name         String
  role         Role
  passwordHash String
  agencyId     String?
  agency       Agency? @relation(fields: [agencyId], references: [id])

  credentials   Credential[]
  claimedShifts Shift[]

  createdAt DateTime @default(now())
}

// A nurse's licence. Uploads start `pending`; only `approved` ones count for
// claims (plan.md, Part 4). Seeded credentials are approved and have no file.
// New ids are cred-<n> from credential_id_seq; the seed inserts its own ids.
// reviewedById has no foreign key to User, like AuditLog.
model Credential {
  id              String           @id @default(dbgenerated("('cred-'::text || nextval('credential_id_seq'::regclass))"))
  nurseId         String
  nurse           User             @relation(fields: [nurseId], references: [id])
  // Last day is the day before expiresOn (plan.md: the expiry date itself is not valid).
  expiresOn       DateTime         @db.Date
  status          CredentialStatus @default(pending)
  createdAt       DateTime         @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  file            CredentialFile?

  @@index([nurseId])
  @@index([status])
}

// The uploaded document, kept apart so lists never load its bytes. Written in
// the same transaction as its Credential row (plan.md, Part 4). Only the
// owning nurse and the admin can read it (lib/credentials.ts).
model CredentialFile {
  credentialId String     @id
  credential   Credential @relation(fields: [credentialId], references: [id])
  fileName     String
  contentType  String // application/pdf | image/png | image/jpeg (CHECK constraint)
  size         Int // bytes, 1..4 MB (CHECK constraint)
  bytes        Bytes
}

// date/startTime/endTime are facility-local, as in the spec.
// endTime < startTime means the shift ends the next day.
// New ids are shift-<n> from shift_id_seq (plan.md); the seed inserts shift-1..3 itself.
model Shift {
  id          String      @id @default(dbgenerated("('shift-'::text || nextval('shift_id_seq'::regclass))"))
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id])
  role        String
  date        DateTime    @db.Date
  startTime   String      @db.VarChar(5)
  endTime     String      @db.VarChar(5)
  status      ShiftStatus @default(open)
  claimedById String?
  claimedBy   User?       @relation(fields: [claimedById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cancellations ShiftCancellation[]

  @@index([agencyId])
  @@index([claimedById])
  @@index([status])
}

// The shift's cancellation history (plan.md, Part 3): one row per cancel,
// written in the same transaction as the reopen. The admin's "reopened
// (no-show / advance)" marker is the latest row.
// No foreign keys to User (like AuditLog): an FK check would lock the nurse's
// row, which a claim by that nurse locks first (lib/cancellations.ts).
model ShiftCancellation {
  id              BigInt   @id @default(autoincrement())
  shiftId         String
  shift           Shift    @relation(fields: [shiftId], references: [id])
  reason          String // "no-show" | "advance" (CHECK constraint)
  previousNurseId String
  cancelledById   String
  cancelledByRole Role
  createdAt       DateTime @default(now())

  @@index([shiftId, id])
}

// Append-only record of successful changes, written in the same transaction
// as the change itself (plan.md). Denied attempts go to server logs instead.
// Each entry is about one shift or one credential (CHECK constraint).
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  createdAt    DateTime @default(now())
  actorId      String
  actorRole    Role
  action       String // "shift.posted|claimed|cancelled", "credential.uploaded|approved|rejected"
  shiftId      String?
  credentialId String?
  details      Json

  @@index([shiftId])
  @@index([credentialId])
  @@index([createdAt])
}
