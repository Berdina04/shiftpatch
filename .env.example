# Copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shiftpatch"
# Integration tests and Playwright use this database (name must end in _test).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shiftpatch_test"
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"
